# Umami Analytics (required for analytics tracking)
NUXT_PUBLIC_UMAMI_ID=your-umami-website-id
NUXT_PUBLIC_UMAMI_HOST=https://your-analytics-host.example.com

# Contact email is configured in app.config.ts

# OpenRouter AI Chat (for the interactive portfolio chat assistant)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
